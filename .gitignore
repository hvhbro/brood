# === ЧУВСТВИТЕЛЬНОЕ / НЕВАЛЕЗИДНОЕ ===

# Минидамп запущенной игры — 7.4GB. GitHub: жёсткий лимит 100MB на файл
# (LFS — 2GB/file). Файл физически не может уехать на GitHub одним куском.
rustme_*.dmp
*.dmp

# Кэш образов jvm.dll (приватный билд) + сторонний тул генерации атласов
tools/cache/
tools/msdf-atlas-gen/

# Скомпилированные промежуточные артефакты (регенерируются build_dll.bat)
jni/agent/build/
jni/dll/src/agent_payload.h
__pycache__/

# javap-темп (копии классов дампа) и javap-диагностики (регенерируются jv.py)
tools/javap_tmp*/
tools/javap_tmp7/
tools/javap_*.txt

# CP-скан (регенерируется scan_all.py за минуту)
tools/scan_db.json


# Скомпилированные классы игры как jar (в dump/ они и так есть)
tools/game_cp.jar
tools/game_stubs.jar
dump/minecraft_FULL_DEOBF.jar
